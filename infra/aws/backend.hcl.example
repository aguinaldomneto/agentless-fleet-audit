# Copie para backend.hcl (fica fora do Git) e preencha com o bucket que você
# criou (README, seção Nuvem). Use com: terraform init -backend-config=backend.hcl
bucket       = "SEU-BUCKET-UNICO-GLOBALMENTE"
key          = "fleet-audit/terraform.tfstate"
region       = "us-east-1"
use_lockfile = true   # lock nativo do S3 (Terraform >= 1.10), sem precisar de DynamoDB
