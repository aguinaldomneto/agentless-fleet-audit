    {
      "id": 7,
      "type": "stat",
      "title": "Tempo médio de resolução (30d)",
      "description": "MTTR: média entre abertura e resolução dos eventos resolvidos nos últimos 30 dias.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "inventory"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "inventory"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT avg(extract(epoch FROM resolved_at - first_seen))\nFROM findings WHERE resolved_at > now() - interval '30 days'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Eventos abertos",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "inventory"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "inventory"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT f.id AS \"Evento\",\n       CASE f.severity WHEN 'critical' THEN 'CRÍTICA' WHEN 'high' THEN 'ALTA' ELSE 'MÉDIA' END AS \"Severidade\",\n       h.name AS \"Host\", f.rule AS \"Regra\", f.subject AS \"Objeto\", f.detail AS \"Detalhe\",\n       f.first_seen AS \"Aberto em\",\n       extract(epoch FROM now() - f.first_seen) AS \"Aberto há\",\n       CASE WHEN f.acked_at IS NOT NULL THEN 'reconhecido por ' || f.acked_by\n            WHEN f.silenced_until > now() THEN 'silenciado até ' || to_char(f.silenced_until AT TIME ZONE 'America/Sao_Paulo', 'DD/MM HH24:MI')\n            WHEN f.notified_at IS NULL THEN 'aviso pendente'\n            ELSE 'avisado (' || f.reminder_count || ' lembrete(s))' END AS \"Tratamento\",\n       f.jira_key AS \"Chamado\",\n       (SELECT value FROM settings WHERE key = 'jira_base_url') || '/browse/' || f.jira_key AS jira_url\nFROM findings f JOIN hosts h ON h.id = f.host_id\nWHERE f.resolved_at IS NULL\nORDER BY sev_rank(f.severity) DESC, f.first_seen"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Severidade"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "CRÍTICA": {
                        "color": "red",
                        "index": 0
                      },
                      "ALTA": {
                        "color": "orange",
                        "index": 1
                      },
                      "MÉDIA": {
                        "color": "yellow",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Aberto há"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Evento"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Chamado"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Abrir no Jira",
                    "url": "${__data.fields.jira_url}",
                    "targetBlank": true
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "jira_url"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Aberto em"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              },
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
