    {
      "id": 10,
      "type": "table",
      "title": "Estado dos hosts",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "inventory"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "inventory"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.host AS \"Host\", h.address AS \"Endereço\", s.os_release AS \"Sistema\",\n       f.kernel AS \"Kernel\", f.uptime_seconds AS \"Uptime\", f.load_5m AS \"Load 5m\",\n       s.last_seen AS \"Última coleta\",\n       CASE WHEN s.last_seen IS NULL THEN 'NUNCA' WHEN s.stale THEN 'ATRASADA' ELSE 'OK' END AS \"Coleta\",\n       s.open_findings AS \"Eventos abertos\"\nFROM v_host_status s\nJOIN hosts h ON h.name = s.host\nLEFT JOIN host_facts f ON f.host_id = h.id\nORDER BY s.open_findings DESC, s.host"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Coleta"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "OK": {
                        "color": "green",
                        "index": 0
                      },
                      "ATRASADA": {
                        "color": "red",
                        "index": 1
                      },
                      "NUNCA": {
                        "color": "orange",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Uptime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Última coleta"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
