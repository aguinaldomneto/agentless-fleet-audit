      "description": "Limites das regras: 85% atenção, 90% crítico.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "inventory"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
