            "type": "grafana-postgresql-datasource",
            "uid": "inventory"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT host || '  ' || mount AS \"Filesystem\", used_pct AS \"Uso\"\nFROM v_fs_latest\nORDER BY used_pct DESC\nLIMIT 20"
