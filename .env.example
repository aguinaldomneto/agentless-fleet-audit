# Gere o .env com segredos aleatórios:  make env   (ou copie e troque tudo à mão)
# Versões fixas: 'latest' muda sozinho (o n8n 2.x trocou 'Active' por 'Publish' no meio
# deste projeto). Atualize de propósito: troque a tag, suba e rode os testes.
# n8n não aceita downgrade do banco: nunca coloque aqui uma versão menor que a já usada.
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.40.5
# grafana-oss parou em 13.0.2 no Docker Hub; grafana/grafana segue publicando.
GRAFANA_IMAGE=grafana/grafana:13.2.2
# Postgres com major fixo: minors são só correções e não mudam o formato dos dados.
# Trocar o major (16 -> 17) NÃO é editar esta linha: use make pg-upgrade (dump/restore).
POSTGRES_IMAGE=postgres:17-alpine

TZ=America/Sao_Paulo

POSTGRES_PASSWORD=troque-me-superuser
N8N_DB_PASSWORD=troque-me-n8n
INVENTORY_RW_PASSWORD=troque-me-inventory
GRAFANA_RO_PASSWORD=troque-me-grafana
GRAFANA_ADMIN_PASSWORD=troque-me-admin

# Gere com: openssl rand -hex 32   (perdeu = credenciais do n8n ilegíveis)
N8N_ENCRYPTION_KEY=

# Token entre n8n e collector-gateway. Gere com: openssl rand -hex 24
GATEWAY_TOKEN=

# Telegram: token do bot (só o telegram-bridge usa) e token entre bridge e n8n
TELEGRAM_BOT_TOKEN=
BRIDGE_TOKEN=

# Cadastra os 3 servidores do laboratório na primeira subida do banco
LOAD_LAB_SEED=true

# Jira (opcional). E-mail da conta Atlassian + API token (id.atlassian.com > Segurança).
# Com os dois preenchidos, make n8n-setup cria a credencial e publica o workflow do Jira.
# Token vence: ao renovar, troque aqui e rode make n8n-setup de novo.
JIRA_EMAIL=
JIRA_API_TOKEN=
