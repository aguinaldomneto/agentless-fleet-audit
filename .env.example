# Gere o .env com segredos aleatórios:  make env   (ou copie e troque tudo à mão)
# Versões: fixe tags específicas antes de publicar (latest quebra reprodutibilidade)
N8N_IMAGE=docker.n8n.io/n8nio/n8n:latest
GRAFANA_IMAGE=grafana/grafana-oss:latest
POSTGRES_IMAGE=postgres:16-alpine

TZ=America/Sao_Paulo

POSTGRES_PASSWORD=troque-me-superuser
N8N_DB_PASSWORD=troque-me-n8n
INVENTORY_RW_PASSWORD=troque-me-inventory
GRAFANA_RO_PASSWORD=troque-me-grafana
GRAFANA_ADMIN_PASSWORD=troque-me-admin

# Gere com: openssl rand -hex 32   (perdeu = credenciais do n8n ilegíveis)
N8N_ENCRYPTION_KEY=

# Token entre n8n e collector-gateway. Gere com: openssl rand -hex 24
GATEWAY_TOKEN=

# Telegram: token do bot (só o telegram-bridge usa) e token entre bridge e n8n
TELEGRAM_BOT_TOKEN=
BRIDGE_TOKEN=

# Cadastra os 3 servidores do laboratório na primeira subida do banco
LOAD_LAB_SEED=true
